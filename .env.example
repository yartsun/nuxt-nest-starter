# Copy to .env for `docker compose up`. Generate a secret with: openssl rand -base64 48
JWT_SECRET=
# Change these outside local development.
POSTGRES_PASSWORD=starter
MEILI_MASTER_KEY=dev-master-key-change-me
# Public URLs as the browser sees them.
WEB_URL=http://localhost:3000
API_URL=http://localhost:3001
# Host ports, if the defaults are taken.
# WEB_PORT=3000
# API_PORT=3001
# Optional OAuth (callback: <API_URL>/auth/<provider>/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

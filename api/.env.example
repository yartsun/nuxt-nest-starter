# Local development of the API outside Docker (npm run start:dev / worker:dev).
# Start the infrastructure first: docker compose up -d postgres redis meilisearch
DATABASE_URL=postgresql://starter:starter@localhost:5432/starter
REDIS_URL=redis://localhost:6379
MEILI_HOST=http://localhost:7700
MEILI_API_KEY=dev-master-key-change-me
WEB_URL=http://localhost:3000
API_URL=http://localhost:3001
# Optional: sign in with Google / GitHub (callback: <API_URL>/auth/<provider>/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
